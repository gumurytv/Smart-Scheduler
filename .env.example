# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AI_TIMETABLE_ENABLED: Server switch for the experimental AI timetable recognition
# (/api/parse-timetable). Anything other than "true" keeps the endpoint disabled (403).
AI_TIMETABLE_ENABLED="false"

# VITE_FEATURE_AI_TIMETABLE: Build-time switch that unlocks the AI recognition UI for
# every user of this build (e.g. a private-test deployment). Individual testers can
# instead open the app once with ?labs=ai-on (?labs=ai-off to turn it back off).
VITE_FEATURE_AI_TIMETABLE="false"

# VITE_API_BASE_URL: Where the Android app (Capacitor) reaches this server, e.g.
# https://teumteum.example.com. Leave empty for the web build (same origin).
VITE_API_BASE_URL=""

# CORS_ALLOWED_ORIGINS: Comma-separated origins allowed to call /api. The Android app's
# origin is https://localhost.
CORS_ALLOWED_ORIGINS="https://localhost"
